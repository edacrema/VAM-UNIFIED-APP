GOOGLE_API_KEY=
LLM_MODEL=
TE_API_KEY=
SEERIST_API_KEY=

# New WFP API Gateway / Databridges v2 credentials.
WFP_V2_API_KEY=
WFP_V2_API_SECRET=
WFP_V2_API_BASE_URL=https://gateway.api.wfp.org/vam-data-bridges/v2
WFP_V2_TOKEN_URL=https://login.microsoftonline.com/462ad9ae-d7d9-4206-b874-71b1e079776f/oauth2/v2.0/token
WFP_V2_API_SCOPE=api://wfp-api-mediation-service/.default
WFP_V2_API_ENV=prod

# Compatibility aliases for older deployments. WFP_V2_* values take precedence.
DATA_BRIDGES_KEY=
DATA_BRIDGES_SECRET=
DATA_BRIDGES_API_BASE_URL=https://gateway.api.wfp.org/vam-data-bridges/v2
DATA_BRIDGES_TOKEN_URL=https://login.microsoftonline.com/462ad9ae-d7d9-4206-b874-71b1e079776f/oauth2/v2.0/token
DATA_BRIDGES_SCOPE=api://wfp-api-mediation-service/.default
DATA_BRIDGES_TIMEOUT=60
DATA_BRIDGES_MAX_RETRIES=3
DATA_BRIDGES_ENV=prod

MARKET_NAMES_GCS_URI=

# Phase 3 app-owned price cache foundation.
PRICE_CACHE_BACKEND=sqlite
PRICE_CACHE_SQLITE_PATH=.tmp/price_cache.sqlite3
PRICE_CACHE_RETAIN_VERSIONS=3
PRICE_CACHE_DATABASE_URL=
PRICE_CACHE_GCP_PROJECT=
PRICE_CACHE_GCP_REGION=europe-west1
PRICE_CACHE_GCP_CLOUD_SQL_INSTANCE=vam-llm-price-cache-beta
